<?xml version="1.0"?>
<sdf version="1.9">
  <model name="stingjet">
    <static>false</static>
    <link name="body">
      <pose>0 0 0 -1.5708 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://stingjet/stingjet.glb</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://stingjet/stingjet.glb</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0.1</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp><kd>10</kd>
              <max_vel>1.0</max_vel><min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <sensor name="contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>
  </model>
</sdf>
