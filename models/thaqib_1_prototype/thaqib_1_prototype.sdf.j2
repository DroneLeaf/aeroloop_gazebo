<!-- thaqib_1_prototype: identical physics to rocket_drone, different visual mesh -->
<sdf version='1.6'>
  <model name='thaqib_1_prototype'>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>{{ "%.6g"|format(mass) }}</mass>
        <inertia>
          <ixx>{{ "%.6g"|format(ixx) }}</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>{{ "%.6g"|format(iyy) }}</iyy>
          <iyz>0</iyz>
          <izz>{{ "%.6g"|format(izz) }}</izz>
        </inertia>
      </inertial>
      <collision name='base_link_inertia_collision'>
        <!-- Box height is 0.11m, so -0.16 keeps its bottom at z=0 instead of intersecting terrain -->
        <pose>0 0 -0.16 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <collide_bitmask>0x01</collide_bitmask>
        </surface>
      </collision>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 -0.10 0 0 0.7854</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://thaqib_1_prototype/meshes/thaqib_1_prototype.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.93 0.90 0.85 1</ambient>
          <diffuse>0.93 0.90 0.85 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <!-- FPV camera sensor (30 degrees below horizon) -->
      <sensor name='fpv_cam' type='camera'>
        <pose>0 0 0.262 0 {{ "%.10g"|format(fpv_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(fpv_hfov_rad) }}</horizontal_fov>
          <image>
            <width>640</width>
            <height>{{ fpv_img_height }}</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
      </sensor>
      <!-- Tracker camera sensor (same mount as FPV, configurable pitch+roll) -->
      <sensor name='fpv_tracker_cam' type='camera'>
        <pose>0 0 0.262 {{ "%.10g"|format(tracker_cam_roll_rad) }} {{ "%.10g"|format(tracker_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(tracker_hfov_rad) }}</horizontal_fov>
          <image>
            <width>640</width>
            <height>{{ tracker_img_height }}</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
      <!-- Chase camera sensor (third-person follow view) -->
      <sensor name='chase_cam' type='camera'>
        <pose>-1.5 0 0.8 0 0.5236 0</pose>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
      <gravity>1</gravity>
      <!-- NOTE: <velocity_decay> is a Gazebo-Classic feature, ignored by gz-sim.
           Body drag is handled by LiftDrag flat-plate plugins below. -->
