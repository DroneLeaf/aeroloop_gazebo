    <!-- Lift/Drag plugins for rotor aerodynamics.
         forward vectors must match rotation direction for upward lift:
           forwardI · v = ω_z · cp.x · fwd.y  must be > 0
         CCW rotors (0,1): multiplier=+1 → ω_z>0 → +cp needs fwd +Y, -cp needs fwd -Y
         CW  rotors (2,3): multiplier=-1 → ω_z<0 → +cp needs fwd -Y, -cp needs fwd +Y
         a0=0.4 rad (~23° blade pitch). area=0.018 calibrated for ~22 N total
         at steady-state ω≈599 rad/s (P=0.01, d=0.004, maxRpm=838).
         Zero-lift climb speed ≈ ωr·tan(a0) = 50.3·tan(0.4) ≈ 21 m/s.  -->

    <!-- rotor_0 (front-right, CCW) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.4</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.2500</cla>
      <cda>0.004</cda>
      <cma>0.00</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.018</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>rotor_0</link_name>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.4</a0>
      <alpha_stall>1.4</alpha_stall>
