<?xml version="1.0" ?>
<!-- Visualization-only iris: no BetaflightPlugin / LiftDrag / ViscousDrag.
     Pose driven by ExternalPosePlugin (UDP 9010).
     Rotor spin driven by RotorVisualPlugin (UDP 9012). -->
<sdf version="1.9">
  <model name="iris">
    <static>false</static>
    <pose>0 0 0.194923 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>{{ "%.6g"|format(mass) }}</mass>
        <inertia>
          <ixx>{{ "%.6g"|format(ixx) }}</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>{{ "%.6g"|format(iyy) }}</iyy><iyz>0</iyz>
          <izz>{{ "%.6g"|format(izz) }}</izz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://betaloop_iris_with_standoffs/meshes/iris.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <visual name='front_left_leg_visual'>
        <pose>0.123 0.22 {{ "%.4g"|format(leg_z) }} 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>{{ "%.4g"|format(standoff_height) }}</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name='front_right_leg_visual'>
        <pose>0.123 -0.22 {{ "%.4g"|format(leg_z) }} 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>{{ "%.4g"|format(standoff_height) }}</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name='rear_left_leg_visual'>
        <pose>-0.140 0.21 {{ "%.4g"|format(leg_z) }} 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>{{ "%.4g"|format(standoff_height) }}</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name='rear_right_leg_visual'>
        <pose>-0.140 -0.21 {{ "%.4g"|format(leg_z) }} 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>{{ "%.4g"|format(standoff_height) }}</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      {%- if pilot_cam_enabled %}
      <sensor name="fpv_cam" type="camera">
        <pose>0.15 0 0.03 0 {{ "%.10g"|format(fpv_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(fpv_hfov_rad) }}</horizontal_fov>
          <image><width>{{ fpv_img_width }}</width><height>{{ fpv_img_height }}</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
      </sensor>
      {%- endif %}
      {%- if tracker_wide_cam_enabled %}
      <!-- Wide tracker: fisheye (wideanglecamera) when tracker_wide_fisheye, else rectilinear. -->
      <sensor name="fpv_tracker_wide_cam" type="{{ 'wideanglecamera' if tracker_wide_fisheye else 'camera' }}">
        <pose>0.15 0 0.03 {{ "%.10g"|format(tracker_wide_cam_roll_rad) }} {{ "%.10g"|format(tracker_wide_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(tracker_wide_hfov_rad) }}</horizontal_fov>
          <image><width>{{ tracker_wide_img_width }}</width><height>{{ tracker_wide_img_height }}</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
          {%- if tracker_wide_fisheye %}
          <lens><type>custom</type><custom_function><c1>{{ tracker_wide_lens_c1 }}</c1><c2>{{ tracker_wide_lens_c2 }}</c2><c3>{{ tracker_wide_lens_c3 }}</c3><f>1.0</f><fun>{{ tracker_wide_lens_fun }}</fun></custom_function><scale_to_hfov>true</scale_to_hfov><cutoff_angle>3.1415</cutoff_angle><env_texture_size>512</env_texture_size></lens>
          {%- endif %}
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ tracker_wide_cam_fps | default(30) }}</update_rate>
        <visualize>0</visualize>
      </sensor>
      {%- endif %}
      {%- if utility_cam_enabled %}
      <!-- Utility camera: clone of the wide tracker; fisheye or rectilinear per utility_fisheye. -->
      <sensor name="fpv_utility_cam" type="{{ 'wideanglecamera' if utility_fisheye else 'camera' }}">
        <pose>0.15 0 0.03 {{ "%.10g"|format(utility_cam_roll_rad) }} {{ "%.10g"|format(utility_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(utility_hfov_rad) }}</horizontal_fov>
          <image><width>{{ utility_img_width }}</width><height>{{ utility_img_height }}</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
          {%- if utility_fisheye %}
          <lens><type>custom</type><custom_function><c1>{{ utility_lens_c1 }}</c1><c2>{{ utility_lens_c2 }}</c2><c3>{{ utility_lens_c3 }}</c3><f>1.0</f><fun>{{ utility_lens_fun }}</fun></custom_function><scale_to_hfov>true</scale_to_hfov><cutoff_angle>3.1415</cutoff_angle><env_texture_size>512</env_texture_size></lens>
          {%- endif %}
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ utility_cam_fps | default(30) }}</update_rate>
        <visualize>0</visualize>
      </sensor>
      {%- endif %}
      {%- if tracker_narrow_enabled %}
      <!-- Narrow tracker: rectilinear (pinhole, MSC-calibrated) or fisheye, per tracker_narrow_fisheye. -->
      <sensor name="fpv_tracker_narrow_cam" type="{{ 'wideanglecamera' if tracker_narrow_fisheye else 'camera' }}">
        <pose>0.15 0 0.03 {{ "%.10g"|format(tracker_narrow_cam_roll_rad) }} {{ "%.10g"|format(tracker_narrow_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(tracker_narrow_hfov_rad) }}</horizontal_fov>
          <image><width>{{ tracker_narrow_img_width }}</width><height>{{ tracker_narrow_img_height }}</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
          {%- if tracker_narrow_fisheye %}
          <lens><type>custom</type><custom_function><c1>{{ tracker_narrow_lens_c1 }}</c1><c2>{{ tracker_narrow_lens_c2 }}</c2><c3>{{ tracker_narrow_lens_c3 }}</c3><f>1.0</f><fun>{{ tracker_narrow_lens_fun }}</fun></custom_function><scale_to_hfov>true</scale_to_hfov><cutoff_angle>3.1415</cutoff_angle><env_texture_size>512</env_texture_size></lens>
          {%- endif %}
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ tracker_narrow_cam_fps | default(30) }}</update_rate>
        <visualize>0</visualize>
      </sensor>
      {%- endif %}
      {%- if thermal_cam_enabled %}
      <!-- Thermal: rectilinear or fisheye (per thermal_fisheye); white-hot recolor in gz_image_bridge. -->
      <sensor name="fpv_thermal_cam" type="{{ 'wideanglecamera' if thermal_fisheye else 'camera' }}">
        <pose>0.15 0 0.03 {{ "%.10g"|format(thermal_cam_roll_rad) }} {{ "%.10g"|format(thermal_cam_pitch_rad) }} 0</pose>
        <camera>
          <horizontal_fov>{{ "%.10g"|format(thermal_hfov_rad) }}</horizontal_fov>
          <image><width>{{ thermal_img_width }}</width><height>{{ thermal_img_height }}</height></image>
          <clip><near>0.05</near><far>15000</far></clip>
          {%- if thermal_fisheye %}
          <lens><type>custom</type><custom_function><c1>{{ thermal_lens_c1 }}</c1><c2>{{ thermal_lens_c2 }}</c2><c3>{{ thermal_lens_c3 }}</c3><f>1.0</f><fun>{{ thermal_lens_fun }}</fun></custom_function><scale_to_hfov>true</scale_to_hfov><cutoff_angle>3.1415</cutoff_angle><env_texture_size>512</env_texture_size></lens>
          {%- endif %}
        </camera>
        <always_on>1</always_on>
        <update_rate>{{ thermal_cam_fps | default(30) }}</update_rate>
        <visualize>0</visualize>
      </sensor>
      {%- endif %}
      {%- if chase_cam_enabled %}
      <sensor name="chase_cam" type="camera">
        <pose>-1.5 0 0.8 0 0.5236 0</pose>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>15000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
      {%- endif %}
    </link>

    <link name="rotor_0"><pose>0.13 -0.22 0.023 0 0 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="rotor_0_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://betaloop_iris_with_standoffs/meshes/iris_prop_ccw.dae</uri></mesh></geometry><material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse><specular>0.1 0.1 0.3 1</specular></material></visual>
    </link>
    <joint name="rotor_0_joint" type="revolute"><child>rotor_0</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_1"><pose>-0.13 0.2 0.023 0 0 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="rotor_1_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://betaloop_iris_with_standoffs/meshes/iris_prop_ccw.dae</uri></mesh></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link>
    <joint name="rotor_1_joint" type="revolute"><child>rotor_1</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_2"><pose>0.13 0.22 0.023 0 0 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="rotor_2_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://betaloop_iris_with_standoffs/meshes/iris_prop_cw.dae</uri></mesh></geometry><material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse><specular>0.1 0.1 0.3 1</specular></material></visual>
    </link>
    <joint name="rotor_2_joint" type="revolute"><child>rotor_2</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <link name="rotor_3"><pose>-0.13 -0.2 0.023 0 0 0</pose>
      <inertial><mass>0.025</mass><inertia><ixx>9.75e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia></inertial>
      <visual name="rotor_3_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://betaloop_iris_with_standoffs/meshes/iris_prop_cw.dae</uri></mesh></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link>
    <joint name="rotor_3_joint" type="revolute"><child>rotor_3</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

    <plugin filename="ExternalPosePlugin" name="gz::sim::systems::ExternalPosePlugin">
      <listen_port>9010</listen_port>
    </plugin>
    <plugin filename="RotorVisualPlugin" name="gz::sim::systems::RotorVisualPlugin">
      <listen_port>9012</listen_port>
      <max_velocity>100.0</max_velocity>
      <spin_dir_0>1</spin_dir_0>
      <spin_dir_1>1</spin_dir_1>
      <spin_dir_2>-1</spin_dir_2>
      <spin_dir_3>-1</spin_dir_3>
    </plugin>
  </model>
</sdf>
