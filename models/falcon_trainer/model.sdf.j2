<?xml version="1.0"?>
<!-- Rendered to model.sdf by betaloop/start.py (render_vis_templates).
     target_scale is parameterised by the target-scale launcher flag / the
     leaf-sim-ui "Target Scale" setting (default 1.0x for falcon_trainer).
     Edit this template, not the generated model.sdf.

     Unlike the .glb targets (shahed/stingjet), this generated OBJ is modeled
     DIRECTLY in the Gazebo body frame (+X nose, +Y span, +Z up), so the link
     needs NO rotation — and TARGET_REFS marks it include_swap: False so the
     proximity bbox is not transposed for include worlds. -->
<sdf version="1.9">
  <model name="falcon_trainer">
    <static>false</static>
    <link name="body">
      <gravity>false</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://falcon_trainer/meshes/falcon_trainer.obj</uri>
            <scale>{{ target_scale | default('1 1 1') }}</scale>
          </mesh>
        </geometry>
        {%- if target_mesh_color %}
        <!-- Flat colour override (target-mesh-color flag); an SDF material
             fully replaces the mesh's own MTL materials in ogre2. -->
        <material>
          <ambient>{{ target_mesh_color }} 1</ambient>
          <diffuse>{{ target_mesh_color }} 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
        {%- endif %}
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://falcon_trainer/meshes/falcon_trainer.obj</uri>
            <scale>{{ target_scale | default('1 1 1') }}</scale>
          </mesh>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0.1</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp><kd>10</kd>
              <max_vel>1.0</max_vel><min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <sensor name="contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/rocket_drone/target_hit</topic>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>
  </model>
</sdf>
