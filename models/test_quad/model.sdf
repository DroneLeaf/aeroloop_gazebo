<?xml version="1.0"?>
<sdf version="1.9">
  <model name="test_quad">
    <pose>0 0 0.5 0 0 0</pose>

    <!-- Base link -->
    <link name="base_link">
      <inertial>
        <mass>0.448522</mass>
        <inertia>
          <ixx>0.00870895</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00870895</iyy>
          <iyz>0.0</iyz>
          <izz>0.0165132</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Rotor 0 (front right) -->
    <link name="rotor_0">
      <pose relative_to="base_link">0.13 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 0.5</ambient>
          <diffuse>1 0 0 0.5</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Rotor 1 (back left) -->
    <link name="rotor_1">
      <pose relative_to="base_link">-0.13 0.20 0.023 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 0 0.5</ambient>
          <diffuse>0 1 0 0.5</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Rotor 2 (front left) -->
    <link name="rotor_2">
      <pose relative_to="base_link">0.13 0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 0.5</ambient>
          <diffuse>0 0 1 0.5</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Rotor 3 (back right) -->
    <link name="rotor_3">
      <pose relative_to="base_link">-0.13 -0.20 0.023 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>0.000167604</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 0 0.5</ambient>
          <diffuse>1 1 0 0.5</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- =================================================================
         Body-frame parasitic drag (flat-plate model on base_link).
         Two horizontal plates at 90° give direction-independent XY drag.
         ================================================================= -->
    <!-- X-axis body drag (decelerates forward/backward motion) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.0</cla>
      <cda>1.0</cda>
      <cma>0.0</cma>
      <cla_stall>0.0</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.10</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0</cp>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
    </plugin>
    <!-- Y-axis body drag (decelerates lateral motion) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.0</cla>
      <cda>1.0</cda>
      <cma>0.0</cma>
      <cla_stall>0.0</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.10</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
    </plugin>
    <!-- Z-axis body drag (vertical damping) -->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <a0>0.0</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>0.0</cla>
      <cda>1.0</cda>
      <cma>0.0</cma>
      <cla_stall>0.0</cla_stall>
      <cda_stall>1.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.20</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0</cp>
      <forward>0 0 1</forward>
      <upward>1 0 0</upward>
      <link_name>base_link</link_name>
    </plugin>

    <!-- BetaflightPlugin -->
    <plugin name="gz::sim::systems::BetaflightPlugin" filename="BetaflightPlugin">
      <imuName>imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>

      <rotor id="0">
        <jointName>rotor_0_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <maxRpm>838</maxRpm>
        <motorNumber>0</motorNumber>
      </rotor>

      <rotor id="1">
        <jointName>rotor_1_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <maxRpm>838</maxRpm>
        <motorNumber>1</motorNumber>
      </rotor>

      <rotor id="2">
        <jointName>rotor_2_joint</jointName>
        <turningDirection>cw</turningDirection>
        <maxRpm>838</maxRpm>
        <motorNumber>2</motorNumber>
      </rotor>

      <rotor id="3">
        <jointName>rotor_3_joint</jointName>
        <turningDirection>cw</turningDirection>
        <maxRpm>838</maxRpm>
        <motorNumber>3</motorNumber>
      </rotor>
    </plugin>

    <!-- Linear viscous drag — models low-speed prop-wash / H-force damping
         that quadratic LiftDrag plates cannot capture.  -->
    <plugin name="gz::sim::systems::ViscousDragPlugin"
            filename="ViscousDragPlugin">
      <link_name>base_link</link_name>
      <linear_damping>0.6</linear_damping>
      <angular_damping>0.03</angular_damping>
    </plugin>
  </model>
</sdf>
