      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
    </plugin>

    <!-- Rotor 3 — Rear-Right, CW -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>rocket_drone</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <actuatorNumber>3</actuatorNumber>
      <motorType>velocity</motorType>
      <maxRotVelocity>838.0</maxRotVelocity>
      <motorConstant>3.275e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1.0e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
    </plugin>

    <plugin name="gz::sim::systems::BetaflightPlugin" filename="BetaflightPlugin">
      <imuName>imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <!-- Motor mapping: SITL sends servo[0]=BF Motor 1 (FR), [1]=Motor 2 (RL), [2]=Motor 3 (FL), [3]=Motor 0 (RR) -->
      <rotor id="0">
        <jointName>rotor_0_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      </rotor>
      <rotor id="1">
        <jointName>rotor_1_joint</jointName>
        <turningDirection>ccw</turningDirection>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      </rotor>
      <rotor id="2">
        <jointName>rotor_2_joint</jointName>
        <turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      </rotor>
      <rotor id="3">
        <jointName>rotor_3_joint</jointName>
        <turningDirection>cw</turningDirection>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      </rotor>
    </plugin>

    <!-- Body-frame aerodynamic drag (per-axis linear + quadratic).
         Forward (X): low drag → 30+ m/s achievable at steep pitch
         Lateral (Y): high drag → stops side-sliding quickly
         Vertical (Z): medium drag
         Angular: strong yaw/pitch/roll damping
         Terminal velocity at 45° pitch ≈ 30 m/s forward.  -->
    <plugin name="gz::sim::systems::ViscousDragPlugin"
            filename="ViscousDragPlugin">
      <link_name>base_link</link_name>
      <linear_damping_x>0.1</linear_damping_x>
      <linear_damping_y>0.4</linear_damping_y>
      <linear_damping_z>0.03</linear_damping_z>
      <quadratic_damping_x>0.001</quadratic_damping_x>
      <quadratic_damping_y>0.03</quadratic_damping_y>
      <quadratic_damping_z>0.001</quadratic_damping_z>
      <angular_damping>0.03</angular_damping>
    </plugin>

    <static>0</static>
  </model>
</sdf>
