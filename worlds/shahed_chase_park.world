<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics name="realtime" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <sky>
        <clouds>
          <speed>5</speed>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>



    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain</name>
      <pose>-100 150 -0.77 0 0 0</pose>
    </include>
    
    <!-- Rocket drone vehicle -->
    <include>
      <uri>model://rocket_drone</uri>
      <name>betaflight_vehicle</name>
      <pose>0 0 1 0 0 0</pose>
    </include>


    <!-- ================================================================
         SHAHED DRONE — full epitrochoid path with banking
         Unchanged from original. orbit(0.45) + zigzag(-1.80) + counter(1.80)
         ================================================================ -->
    <model name="shahed_drone">
      <static>false</static>
      <pose>0 0 20 0 0 0</pose>

      <link name="orbit_center">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>orbit_center</child>
      </joint>

      <link name="arm_link">
        <pose relative_to="orbit_center">30 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="orbit_joint" type="revolute">
        <pose relative_to="orbit_center">0 0 0 0 0 0</pose>
        <parent>orbit_center</parent>
        <child>arm_link</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="crank_link">
        <pose relative_to="arm_link">0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="zigzag_joint" type="revolute">
        <pose relative_to="arm_link">0 0 0 0 0 0</pose>
        <parent>arm_link</parent>
        <child>crank_link</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="drone_stabilizer">
        <pose relative_to="crank_link">4.5 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>

        <!--
        <sensor name="bottom-left" type="camera">
          <pose>-2.0 -2.0 -1.5 0 -0.3 0.7</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>bottom-left/image</topic>
        </sensor>

        <sensor name="bottom-right" type="camera">
          <pose>2.0 -2.0 -1.5 0 -0.3 2.4416</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>bottom-right/image</topic>
        </sensor>

        <sensor name="mid-back" type="camera">
          <pose>0 -3.0 -0.8 0 0 1.570796</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>mid-back/image</topic>
        </sensor>
        
        <sensor name="mid-left" type="camera">
          <pose>-2.0 -2.0 -0.8 0 0 0.7</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>mid-left/image</topic>
        </sensor>

        <sensor name="mid-right" type="camera">
          <pose>2.0 -2.0 -0.8 0 0 2.4416</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>mid-right/image</topic>
        </sensor>

        <sensor name="bottom-back" type="camera">
          <pose>0 -3.0 -1.5 0 -0.3 1.570796</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>bottom-back/image</topic>
        </sensor>

        <sensor name="top-left" type="camera">
          <pose>-2.0 -2.0 -0.1 0 0.3 0.7</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>top-left/image</topic>
        </sensor>

        <sensor name="top-right" type="camera">
          <pose>2.0 -2.0 -0.1 0 0.3 2.4416</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>top-right/image</topic>
        </sensor> -->
      </link>

      <link name="top_back_arm_link">
        <pose relative_to="drone_stabilizer">0 -7.0 0.1 0 0 0</pose>
        <gravity>false</gravity>
        <self_collide>false</self_collide>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
      </link>

      <joint name="top_back_arm_joint" type="revolute">
        <pose relative_to="drone_stabilizer">0 0 0 0 0 0</pose>
        <parent>drone_stabilizer</parent>
        <child>top_back_arm_link</child>
        <axis>
          <xyz expressed_in="__model__">1 0 0</xyz>
          <limit>
            <lower>-0.262</lower>
            <upper>0.262</upper>
            <effort>1000000</effort>
          </limit>
          <dynamics>
            <damping>0.02</damping>
            <friction>0.001</friction>
          </dynamics>
        </axis>
      </joint>

      <link name="top_back_yaw_link">
        <pose relative_to="top_back_arm_link">0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <self_collide>false</self_collide>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
      </link>

      <link name="top_back_cam_link">
        <pose relative_to="top_back_yaw_link">0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <self_collide>false</self_collide>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>

        <!-- Keep chase_cam/image topic for launcher auto-discovery. -->
        <sensor name="chase_cam" type="camera">
          <pose>0 0 -1.2 0 0 1.570796</pose>
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>60</update_rate>
          <visualize>true</visualize><topic>chase_cam/image</topic>
        </sensor>
      </link>

      <joint name="top_back_yaw_joint" type="revolute">
        <pose relative_to="top_back_arm_link">0 0 0 0 0 0</pose>
        <parent>top_back_arm_link</parent>
        <child>top_back_yaw_link</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit>
            <lower>-0.349066</lower>
            <upper>0.349066</upper>
            <effort>1000000</effort>
          </limit>
          <dynamics>
            <damping>0.02</damping>
            <spring_stiffness>0.6</spring_stiffness>
            <friction>0.001</friction>
          </dynamics>
        </axis>
      </joint>

      <joint name="top_back_pitch_joint" type="fixed">
        <pose relative_to="top_back_yaw_link">0 0 0 0 0 0</pose>
        <parent>top_back_yaw_link</parent>
        <child>top_back_cam_link</child>
      </joint>

      <joint name="counter_joint" type="revolute">
        <pose relative_to="drone_stabilizer">0 0 0 0 0 0</pose>
        <parent>crank_link</parent>
        <child>drone_stabilizer</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="geranium_link">
        <pose relative_to="drone_stabilizer">0 0 -0.8 0 0 0</pose>
        <gravity>true</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 3.14159</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <pose>0 0 0 1.57079 0 3.14159</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>0.0</threshold>
            </bounce>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact>
              <ode>
                <kp>100000</kp><kd>10</kd>
                <max_vel>1.0</max_vel><min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50.0</update_rate>
          <contact><collision>collision</collision></contact>
        </sensor>
      </link>

      <joint name="roll_joint" type="revolute">
        <pose relative_to="drone_stabilizer">0 0 0 0 0 0</pose>
        <parent>drone_stabilizer</parent>
        <child>geranium_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <dynamics>
            <damping>0.8</damping>
            <friction>0.05</friction>
            <spring_reference>0</spring_reference>
            <spring_stiffness>4.0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>orbit_joint</joint_name>
        <initial_velocity>0.45</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>zigzag_joint</joint_name>
        <initial_velocity>-1.80</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>counter_joint</joint_name>
        <initial_velocity>1.80</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>top_back_yaw_joint</joint_name>
        <initial_velocity>0.0</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>top_back_arm_joint</joint_name>
        <initial_velocity>0.0</initial_velocity>
      </plugin>

    </model>

    <!-- ================================================================
         CHASE CAMERA — completely separate model, no connection to drone.
         Traces a simple circle at the same 30m radius and 20m altitude.
         Runs at 0.38 rad/s (vs drone orbit 0.45) so it lags ~16% behind.
         Camera points INWARD toward world origin (where drone orbit center is)
         with a slight downward pitch to keep drone in frame.

         The camera body never rolls, never zigzags, never banks.
         It just smoothly circles at constant speed, always behind the drone.

         To adjust lag: change chase_orbit velocity.
           More lag  → lower speed (e.g. 0.32)
           Less lag  → raise speed closer to 0.45 (e.g. 0.42)

         To adjust camera height offset: change cam_arm z in pose.
         To adjust how far behind: change the phase at start by offsetting
           the initial arm_link pose angle — or just tune the speed delta.
         ================================================================ -->
    <!-- <model name="chase_camera">
      <static>false</static> -->
      <!-- Same world height as drone (z=20), starts at same position -->
      <!-- <pose>0 0 20 0 0 0</pose> -->

      <!-- World anchor for camera orbit -->
      <!-- <link name="chase_center">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="chase_world_anchor" type="fixed">
        <parent>world</parent>
        <child>chase_center</child>
      </joint> -->

      <!-- Camera arm — same 30m radius as drone orbit arm.
           Camera sits at end of arm, pointing inward (toward origin).
           z=2 raises it 2m above drone flight plane for a top-down angle. -->
      <!-- <link name="cam_arm">
        <pose relative_to="chase_center">30 0 -1 -0.3 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial> -->

        <!-- Camera sensor:
             - Points inward toward origin: yaw = PI (3.14159) faces -X = inward
             - pitch = 0.25 rad tilts down ~14 deg to frame drone vertically
             - No roll — camera stays perfectly level always
             Adjust pitch up (larger value) if drone appears too high in frame.
             Adjust z on cam_arm pose to raise/lower camera position. -->
        <!-- <sensor name="shahed_chase_cam" type="camera">
          <pose>0 -5.5 0 0 0 1.6</pose>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10000</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>60</update_rate>
          <visualize>true</visualize>
          <topic>shahed_chase_cam/image</topic>
        </sensor>
      </link>

      <joint name="chase_orbit_joint" type="revolute">
        <pose relative_to="chase_center">0 0 0 0 0 0</pose>
        <parent>chase_center</parent>
        <child>cam_arm</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>chase_orbit_joint</joint_name> -->
        <!-- Slightly slower than drone orbit (0.45) → camera lags behind.
             At this delta the camera is roughly 1-2s behind on each loop. -->
        <!-- <initial_velocity>0.44</initial_velocity>
      </plugin>

    </model> -->

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
