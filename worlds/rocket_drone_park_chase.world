<?xml version="1.0" ?>
<!--
  Visualization-only world for rocket_drone with Simulink dynamics backend.
  Gazebo renders only — physics engine present for WorldPoseCmd + JointVelocityCmd.
  Drone pose is driven externally via ExternalPosePlugin (UDP 9010).
  Rotor spinning driven by RotorVisualPlugin (UDP 9012).
-->
<sdf version="1.9">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World-level plugins: physics needed for WorldPoseCmd + JointVelocityCmd -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <sky>
        <clouds>
          <speed>5</speed>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane (visual only, no collision needed) -->
    <!-- <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.25 1</ambient>
            <diffuse>0.25 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model> -->

    <include>
      <uri>
      model://baylands_terrain</uri>
      <name>baylands_terrain1</name>
      <pose>-35 177 -1.922 0 0 0</pose>
    </include>

    <include>
      <uri>
      model://baylands_terrain</uri>
      <name>baylands_terrain2</name>
      <pose>600 146 -2.37 0 0 0</pose>
    </include>

    <include>
      <uri>
      model://baylands_terrain</uri>
      <name>baylands_terrain3</name>
      <pose>55.68 329.6 -2.24 0 0 -3.14</pose>
    </include>

    <include>
      <uri>
      model://baylands_terrain</uri>
      <name>baylands_terrain4</name>
      <pose>259.4 -514.32 -3.044 0 0 3.14</pose>
    </include>
    

    <!-- ============================================================
         Rocket Drone — visualization-only (inlined from rocket_drone model)
         No collisions, no IMU, no BetaflightPlugin, no LiftDrag.
         Pose driven by ExternalPosePlugin via UDP.
         ============================================================ -->
    <model name="betaflight_vehicle">
      <pose>0 0 0.3 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.029125</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.029125</iyy>
            <iyz>0</iyz>
            <izz>0.055225</izz>
          </inertia>
        </inertial>
        <visual name="base_link_inertia_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>model://rocket_drone/meshes/rocket_drone.stl</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/DarkGrey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <!-- FPV camera sensor (30 degrees below horizon) -->
        <sensor name="fpv_cam" type="camera">
          <pose>0 0 0.262 0 -0.523599 0</pose>
          <camera>
            <horizontal_fov>2.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>15000</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>1</visualize>
        </sensor>
        <!-- Landing standoffs (4 legs at motor positions) -->
        <visual name='front_right_leg_visual'>
          <pose>0.13 -0.22 -0.125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.005</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <visual name='rear_left_leg_visual'>
          <pose>-0.13 0.22 -0.125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.005</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <visual name='front_left_leg_visual'>
          <pose>0.13 0.22 -0.125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.005</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <visual name='rear_right_leg_visual'>
          <pose>-0.13 -0.22 -0.125 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.005</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <!-- Chase camera sensor (third-person follow view) -->
        <sensor name="chase_cam" type="camera">
          <pose>-1.5 0 0.8 0 0.5236 0</pose>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>15000</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>0</visualize>
        </sensor>
      </link>

      <!-- Rotor 0: front-right (CCW) -->
      <link name="rotor_0">
        <pose>0.13 -0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_0_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://rocket_drone/meshes/rocket_drone_prop_ccw.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Blue</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <child>rotor_0</child>
        <parent>base_link</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- Rotor 1: rear-left (CCW) -->
      <link name="rotor_1">
        <pose>-0.13 0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_1_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://rocket_drone/meshes/rocket_drone_prop_ccw.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/DarkGrey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <child>rotor_1</child>
        <parent>base_link</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- Rotor 2: front-left (CW) -->
      <link name="rotor_2">
        <pose>0.13 0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_2_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://rocket_drone/meshes/rocket_drone_prop_cw.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Blue</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <child>rotor_2</child>
        <parent>base_link</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- Rotor 3: rear-right (CW) -->
      <link name="rotor_3">
        <pose>-0.13 -0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000273104</iyy><iyz>0</iyz>
            <izz>0.000274004</izz>
          </inertia>
        </inertial>
        <visual name="rotor_3_visual">
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://rocket_drone/meshes/rocket_drone_prop_cw.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/DarkGrey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <child>rotor_3</child>
        <parent>base_link</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e+16</lower>
            <upper>1e+16</upper>
          </limit>
          <dynamics>
            <damping>0.004</damping>
          </dynamics>
        </axis>
      </joint>

      <!-- ExternalPosePlugin: receives VisualPose from bf_sim_bridge on UDP 9010 -->
      <plugin filename="ExternalPosePlugin" name="gz::sim::systems::ExternalPosePlugin">
        <listen_port>9010</listen_port>
      </plugin>

      <!-- RotorVisualPlugin: spins rotors based on motor commands from bf_sim_bridge -->
      <plugin filename="RotorVisualPlugin" name="gz::sim::systems::RotorVisualPlugin">
        <listen_port>9012</listen_port>
        <max_velocity>100.0</max_velocity>
        <!-- CCW rotors (0,1): +1, CW rotors (2,3): -1 -->
        <spin_dir_0>1</spin_dir_0>
        <spin_dir_1>1</spin_dir_1>
        <spin_dir_2>-1</spin_dir_2>
        <spin_dir_3>-1</spin_dir_3>
      </plugin>
    </model>

    <!-- Moving geranium target: locked to a straight prismatic track, but free to pivot -->
    <model name="moving_target_drone">
      <static>false</static>
      
      <!-- 1. Anchor fixed to the world -->
      <link name="track_anchor">
        <pose>0 0 20 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="world_anchor_joint" type="fixed">
        <parent>world</parent>
        <child>track_anchor</child>
      </joint>

      <!-- 2. Carriage that slides along the straight rail -->
      <link name="carriage">
        <pose>0 0 20 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="patrol_rail" type="prismatic">
        <parent>track_anchor</parent>
        <child>carriage</child>
        <axis>
          <xyz>1 0 0</xyz> <!-- Constrained EXACTLY to the X axis -->
          <limit><lower>0</lower><upper>300</upper></limit>
          <dynamics><damping>20.0</damping></dynamics> <!-- Heavy damping bounds top speed and prevents overshoot -->
        </axis>
      </joint>

      <!-- 3. Target body that sits on the carriage and can pivot 180 degrees -->
      <link name="geranium_link">
        <pose>0 0 20 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
            <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 -1.57079</pose>
          <geometry>
            <mesh>
              <uri>model://rocket_drone/meshes/geranium-2.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="pivot" type="revolute">
        <parent>carriage</parent>
        <child>geranium_link</child>
        <axis>
          <xyz>0 0 1</xyz> <!-- Free to rotate 180 degrees around Z axis -->
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
          <dynamics><damping>5.0</damping></dynamics> <!-- Damping prevents rapid infinite spinning -->
        </axis>
      </joint>

      <!-- 4. Trajectory follower pushes the pivot body -->
      <!-- Because it is mounted on the rail, it cannot wander sideways. -->
      <!-- Because it generates a forward force, turning the body 180 degrees reverses its direction! -->
      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>geranium_link</link_name>
        <loop>true</loop>
        <force>100.0</force> <!-- Pushes against the Prismatic damping -->
        <torque>20.0</torque> <!-- Rotates against the Revolute damping -->
        <range_tolerance>1.0</range_tolerance>
        <bearing_tolerance>5.0</bearing_tolerance>
        <zero_vel_on_bearing_reached>true</zero_vel_on_bearing_reached>
        <waypoints>
          <waypoint>299 0</waypoint>
          <waypoint>1 0</waypoint>
        </waypoints>
      </plugin>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
