<?xml version="1.0" ?>
<!--
  Visualization-only world for rocket_drone park chase with Simulink dynamics backend.
  Gazebo renders only — physics engine present for WorldPoseCmd + JointVelocityCmd.
  Drone pose is driven externally via ExternalPosePlugin (UDP 9010).
  Rotor spinning driven by RotorVisualPlugin (UDP 9012).
  Target: orbiting Shahed at altitude 50m, arm radius 30m, orbit speed 0.05 rad/s — patchable via start.py.
-->
<sdf version="1.9">
  <world name="fpv_chase_park">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <sky>
        <clouds>
          <speed>5</speed>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://rocket_drone</uri>
      <name>rocket_drone</name>
      <pose>-100 150 -0.77 0 0 0</pose>
    </include>

    <!-- Rocket Drone — visualization-only (inlined, no physics) -->
    <model name="rocket_drone">
      <pose>0 0 0.3 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1.1213</mass>
          <inertia>
            <ixx>0.0217724</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0217724</iyy><iyz>0</iyz>
            <izz>0.0412831</izz>
          </inertia>
        </inertial>
        <visual name="base_link_inertia_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.001 0.001 0.001</scale>
              <uri>model://rocket_drone/meshes/rocket_drone.stl</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <name>Gazebo/DarkGrey</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <sensor name="fpv_cam" type="camera">
          <pose>0 0 0.262 0 -1.396263402 0</pose>
          <camera>
            <horizontal_fov>2.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>15000</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>1</visualize>
        </sensor>
        <visual name='front_right_leg_visual'>
          <pose>0.13 -0.22 -0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name='rear_left_leg_visual'>
          <pose>-0.13 0.22 -0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name='front_left_leg_visual'>
          <pose>0.13 0.22 -0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <visual name='rear_right_leg_visual'>
          <pose>-0.13 -0.22 -0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.005</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <sensor name="chase_cam" type="camera">
          <pose>-1.5 0 0.8 0 0.5236 0</pose>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>15000</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>0</visualize>
        </sensor>
      </link>

      <link name="rotor_0"><pose>0.13 -0.22 0.023 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000273104</iyy><iyz>0</iyz><izz>0.000274004</izz></inertia></inertial>
        <visual name="rotor_0_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://rocket_drone/meshes/rocket_drone_prop_ccw.dae</uri></mesh></geometry><material><script><name>Gazebo/Blue</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      </link>
      <joint name="rotor_0_joint" type="revolute"><child>rotor_0</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

      <link name="rotor_1"><pose>-0.13 0.22 0.023 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000273104</iyy><iyz>0</iyz><izz>0.000274004</izz></inertia></inertial>
        <visual name="rotor_1_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://rocket_drone/meshes/rocket_drone_prop_ccw.dae</uri></mesh></geometry><material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      </link>
      <joint name="rotor_1_joint" type="revolute"><child>rotor_1</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

      <link name="rotor_2"><pose>0.13 0.22 0.023 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000273104</iyy><iyz>0</iyz><izz>0.000274004</izz></inertia></inertial>
        <visual name="rotor_2_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://rocket_drone/meshes/rocket_drone_prop_cw.dae</uri></mesh></geometry><material><script><name>Gazebo/Blue</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      </link>
      <joint name="rotor_2_joint" type="revolute"><child>rotor_2</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

      <link name="rotor_3"><pose>-0.13 -0.22 0.023 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>9.75e-07</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000273104</iyy><iyz>0</iyz><izz>0.000274004</izz></inertia></inertial>
        <visual name="rotor_3_visual"><geometry><mesh><scale>1 1 1</scale><uri>model://rocket_drone/meshes/rocket_drone_prop_cw.dae</uri></mesh></geometry><material><script><name>Gazebo/DarkGrey</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material></visual>
      </link>
      <joint name="rotor_3_joint" type="revolute"><child>rotor_3</child><parent>base_link</parent><axis><xyz>0 0 1</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit><dynamics><damping>0.004</damping></dynamics></axis></joint>

      <plugin filename="ExternalPosePlugin" name="gz::sim::systems::ExternalPosePlugin">
        <listen_port>9010</listen_port>
      </plugin>
      <plugin filename="RotorVisualPlugin" name="gz::sim::systems::RotorVisualPlugin">
        <listen_port>9012</listen_port>
        <max_velocity>100.0</max_velocity>
        <spin_dir_0>1</spin_dir_0>
        <spin_dir_1>1</spin_dir_1>
        <spin_dir_2>-1</spin_dir_2>
        <spin_dir_3>-1</spin_dir_3>
      </plugin>
    </model>

    <!-- Moving Shahed target: revolves around orbit_center in a circle -->
    <model name="moving_target_drone">
      <static>false</static>
      <pose>0 0 50 0 0 0</pose>

      <link name="orbit_center">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>orbit_center</child>
      </joint>

      <link name="arm_link">
        <pose relative_to="orbit_center">30 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="orbit_joint" type="revolute">
        <pose relative_to="orbit_center">0 0 0 0 0 0</pose>
        <parent>orbit_center</parent>
        <child>arm_link</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="crank_link">
        <pose relative_to="arm_link">0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="zigzag_joint" type="revolute">
        <pose relative_to="arm_link">0 0 0 0 0 0</pose>
        <parent>arm_link</parent>
        <child>crank_link</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="drone_stabilizer">
        <pose relative_to="crank_link">4.5 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="counter_joint" type="revolute">
        <pose relative_to="drone_stabilizer">0 0 0 0 0 0</pose>
        <parent>crank_link</parent>
        <child>drone_stabilizer</child>
        <axis><xyz expressed_in="__model__">0 0 1</xyz></axis>
      </joint>

      <link name="geranium_link">
        <pose relative_to="drone_stabilizer">0 0 -0.8 0 0 0</pose>
        <gravity>true</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 3.14159</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <joint name="roll_joint" type="revolute">
        <pose relative_to="drone_stabilizer">0 0 0 0 0 0</pose>
        <parent>drone_stabilizer</parent>
        <child>geranium_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <dynamics>
            <damping>0.8</damping>
            <friction>0.05</friction>
            <spring_reference>0</spring_reference>
            <spring_stiffness>4.0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>orbit_joint</joint_name>
        <initial_velocity>0.2</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>zigzag_joint</joint_name>
        <initial_velocity>-0.0</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>counter_joint</joint_name>
        <initial_velocity>0.0</initial_velocity>
      </plugin>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
