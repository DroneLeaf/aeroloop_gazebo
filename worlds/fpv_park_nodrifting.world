<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <sky>
        <clouds>
          <speed>5</speed>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain1</name>
      <pose>-35 177 -1.922 0 0 0</pose>
    </include>
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain2</name>
      <pose>600 146 -2.37 0 0 0</pose>
    </include>
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain3</name>
      <pose>55.68 329.6 -2.24 0 0 -3.14</pose>
    </include>
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain4</name>
      <pose>259.4 -514.32 -3.044 0 0 3.14</pose>
    </include>

    <!-- Rocket drone vehicle -->
    <include>
      <uri>model://rocket_drone</uri>
      <name>betaflight_vehicle</name>
      <pose>0 0 0.3 0 0 0</pose>
    </include>

    <!-- Moving target: slides back and forth along X axis -->
    <model name="moving_target_drone">
      <static>false</static>
      <pose>0 0 20 0 0 0</pose>

      <!-- Fixed base anchored to world -->
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="world_fix" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>

      <!-- Carriage slides along X -->
      <link name="carriage">
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
      </link>
      <joint name="patrol_rail" type="prismatic">
        <parent>base_link</parent>
        <child>carriage</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-200</lower>
            <upper>300</upper>
            <effort>1e6</effort>
          </limit>
          <dynamics><damping>1.0</damping></dynamics>
        </axis>
      </joint>

      <!-- Visible target body -->
      <link name="geranium_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
            <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 -1.57079</pose>
          <geometry>
            <mesh>
              <uri>model://rocket_drone/meshes/geranium-2.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Revolute joint allows target to rotate 180 deg to face return direction -->
      <joint name="pivot" type="revolute">
        <parent>carriage</parent>
        <child>geranium_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
            <effort>1e6</effort>
          </limit>
          <dynamics><damping>2.0</damping></dynamics>
        </axis>
      </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>patrol_rail</joint_name>
      <initial_velocity>10.0</initial_velocity>
    </plugin>


    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pivot</joint_name>
      <p_gain>10.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
  </model>
  

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
