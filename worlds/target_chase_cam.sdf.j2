{#- target_chase_cam.sdf.j2 — Jinja2 template for target chase world.
   Rendered at startup by target_chase/start.py with computed parameters.

   Architecture: Two independent models driven by ExternalPosePlugin via UDP.
   Python orchestrator computes orbit + slide + bank poses at 60 Hz and sends
   72-byte VisualPosePacket structs — zero subprocess overhead. -#}
<?xml version="1.0" ?>
<!--
  Orbiting target drone with chase camera.
  Drone and camera poses driven by Python via UDP → ExternalPosePlugin.
  Generated from target_chase_cam.sdf.j2 by target_chase/start.py.
  Parameters:
    orbit_radius   = {{ orbit_radius }} m
    altitude       = {{ altitude }} m
    chase_distance = {{ chase_distance }} m
    hfov           = {{ "%.4f"|format(hfov) }} rad
-->
<sdf version="1.9">
  <world name="target_chase">
    <physics name="realtime" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      {%- if clouds %}
      <sky>
        <clouds>
          <speed>3</speed>
          <humidity>{{ cloud_density }}</humidity>
          <mean_size>{{ cloud_density }}</mean_size>
        </clouds>
      </sky>
      {%- endif %}
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.85 0.7 1</diffuse>
      <specular>0.3 0.25 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="desert_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.76 0.60 0.42 1</ambient>
            <diffuse>0.76 0.60 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain</name>
      <pose>-100 150 -0.77 0 0 0</pose>
    </include>

    <!-- ═══════════════════════════════════════════════════════════════
         Target drone — Shahed mesh, pose driven by Python via UDP.
         ExternalPosePlugin listens on port 9020.
         ═══════════════════════════════════════════════════════════════ -->
    <model name="target_geranium">
      <static>false</static>
      <pose>{{ orbit_radius }} 0 {{ altitude }} 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 3.14159</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <plugin filename="ExternalPosePlugin"
              name="gz::sim::systems::ExternalPosePlugin">
        <listen_port>9020</listen_port>
      </plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         Chase camera — pose driven by Python via UDP.
         ExternalPosePlugin listens on port 9021.
         Camera optical axis = model +X (Gazebo default).
         ═══════════════════════════════════════════════════════════════ -->
    <model name="chase_camera_rig">
      <static>false</static>
      <pose>{{ orbit_radius }} {{ -chase_distance }} {{ altitude }} 0 0 1.5708</pose>
      <link name="cam_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <sensor name="chase_cam" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>{{ "%.6f"|format(hfov) }}</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>RGB_INT8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>500</far>
            </clip>
          </camera>
        </sensor>
      </link>
      <plugin filename="ExternalPosePlugin"
              name="gz::sim::systems::ExternalPosePlugin">
        <listen_port>9021</listen_port>
      </plugin>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 {{ altitude + 5 }} 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
