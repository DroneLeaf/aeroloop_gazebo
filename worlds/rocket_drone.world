<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <physics name="realtime" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <scene>
      <sky>
        <clouds>
          <speed>5</speed>
          <humidity>0.6</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.25 1</ambient>
            <diffuse>0.25 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rocket drone vehicle -->
    <include>
      <uri>model://rocket_drone</uri>
      <name>betaflight_vehicle</name>
      <pose>0 0 0.3 0 0 0</pose>
    </include>


    <!-- Moving geranium target: revolves around orbit_center in a circle -->
    <model name="moving_target_drone">
      <static>false</static>
      <pose>0 0 20 0 0 0</pose>

      <link name="orbit_center">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>orbit_center</child>
      </joint>

      <link name="geranium_link">
        <pose>0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.02</ixx>
            <iyy>0.02</iyy>
            <izz>0.04</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <pose>10 0 0 1.57079 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://rocket_drone/meshes/geranium-2.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>10 0 0 1.57079 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://rocket_drone/meshes/geranium-2.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <bounce>
              <restitution_coefficient>0.1</restitution_coefficient>
              <threshold>0.0</threshold>
            </bounce>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000</kp>
                <kd>10</kd>
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <sensor name="contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>50.0</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
      </link>

      <joint name="orbit_joint" type="revolute">
        <parent>orbit_center</parent>
        <child>geranium_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <use_parent_model_frame>1</use_parent_model_frame>
          <dynamics>
            <damping>0.0</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>orbit_joint</joint_name>
        <initial_velocity>0.6</initial_velocity>
      </plugin>
    </model>

    <!-- Physical cloud layer for camera visibility -->
    <model name="cloud_layer">
      <static>true</static>
      <pose>0 0 2000 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 -1</normal>
              <size>20000 20000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
