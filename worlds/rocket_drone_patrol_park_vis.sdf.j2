<?xml version="1.0" ?>
<!--
  Visualization-only world for rocket_drone patrol park with Simulink dynamics backend.
  Gazebo renders only — physics engine present for WorldPoseCmd + JointVelocityCmd.
  Drone pose is driven externally via ExternalPosePlugin (UDP 9010).
  Rotor spinning driven by RotorVisualPlugin (UDP 9012).
  Target: straight-line patrol at altitude, back-and-forth along X-axis.
  Patrol length and speed are patchable via start.py.
-->
<sdf version="1.9">
  <world name="fpv_patrol_park">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      <sky>
        <clouds>
          <speed>3</speed>
          <humidity>0.1</humidity>
          <mean_size>0.3</mean_size>
        </clouds>
      </sky>
      <background>0.85 0.75 0.55 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.85 0.7 1</diffuse>
      <specular>0.3 0.25 0.2 1</specular>
      <attenuation>
        <range>20000</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Terrain reference near spawn point -->
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain</name>
      <pose>-100 150 -0.77 0 0 0</pose>
    </include>

    <!-- Large ground plane for extended patrol area -->
    <model name="desert_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20000 20000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.76 0.60 0.42 1</ambient>
            <diffuse>0.76 0.60 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone — visualization-only (included from vis model, no physics) -->
    <include>
      <uri>{{ drone_vis_uri }}</uri>
      <name>{{ drone_name }}</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Patrol target: straight-line back-and-forth along X-axis -->
    <model name="patrol_target_drone">
      <static>false</static>
      <pose>0 0 {{ "%.4g"|format(target_altitude) }} 0 0 0</pose>

      <link name="anchor">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>
      <joint name="world_anchor" type="fixed">
        <parent>world</parent>
        <child>anchor</child>
      </joint>

      <link name="geranium_link">
        <pose relative_to="anchor">0 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>
        <visual name="visual">
          <pose>0 0 0 1.57079 0 3.14159</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <joint name="patrol_joint" type="prismatic">
        <parent>anchor</parent>
        <child>geranium_link</child>
        <axis>
          <xyz expressed_in="__model__">1 0 0</xyz>
          <limit>
            <lower>{{ "%.4g"|format(-patrol_length / 2) }}</lower>
            <upper>{{ "%.4g"|format(patrol_length / 2) }}</upper>
            <effort>1e6</effort>
          </limit>
        </axis>
      </joint>

      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>patrol_joint</joint_name>
        <initial_velocity>{{ "%.6g"|format(patrol_speed_ms) }}</initial_velocity>
      </plugin>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
