<?xml version="1.0" ?>
<!--
  Visualization-only world for the rocket_drone shake-table / IMU test.
  Gazebo renders only — physics engine present for WorldPoseCmd.
  Drone pose is driven externally via ExternalPosePlugin (UDP 9010); the
  bf_sim_bridge runs in shake mode, so the drone oscillates horizontally (X/Y)
  with a coupled roll/pitch rocking about the spawn pose, and BF's IMU
  (gyro + accel, MSP_RAW_IMU) reflects that harmonic motion.
  Rotor spinning driven by RotorVisualPlugin (UDP 9012).
  No target model — this world exercises the drone's own dynamics/IMU only.
-->
<sdf version="1.9">
  <world name="shake_test">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      {%- if clouds %}
      <sky>
        <time>10</time>
        <clouds>
          <speed>12</speed>
          <direction>1.2</direction>
          <humidity>{{ cloud_density }}</humidity>
          <mean_size>{{ cloud_density }}</mean_size>
        </clouds>
      </sky>
      {%- endif %}
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane (visual only) -->
    <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.25 1</ambient>
            <diffuse>0.25 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pedestal — static vis-only cylinder marking the launch stand. Dimensions
         track the Simulink pedestal (pedestal_radius / pedestal_height) so the
         visual base lines up with the on-pedestal attitude physics. -->
    {%- set _ped_r = pedestal_radius | default(0.5) %}
    {%- set _ped_h = pedestal_height | default(0.30) %}
    {%- if _ped_h > 0 %}
    <model name="launch_pedestal">
      <static>true</static>
      <pose>0 0 {{ "%.4g"|format(_ped_h / 2.0) }} 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>true</cast_shadows>
          <geometry>
            <cylinder>
              <radius>{{ "%.4g"|format(_ped_r) }}</radius>
              <length>{{ "%.4g"|format(_ped_h) }}</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.21 0.24 1</ambient>
            <diffuse>0.33 0.34 0.38 1</diffuse>
            <specular>0.25 0.25 0.28 1</specular>
          </material>
        </visual>
      </link>
    </model>
    {%- endif %}

    <!-- Drone — visualization-only, pose driven via ExternalPosePlugin UDP 9010 -->
    <include>
      <uri>{{ drone_vis_uri }}</uri>
      <name>{{ drone_name }}</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Static target for the (shaking) drone to look at — a fixed balloon
         (selectable target, defaults to balloon) placed in front at the target
         distance. No ExternalPosePlugin: it holds still. -->
    <model name="shake_target">
      <static>true</static>
      <pose>{{ "%.4g"|format(target_x) }} {{ "%.4g"|format(target_y) }} {{ "%.4g"|format(target_z) }} 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          {%- if target_primitive == 'sphere' %}
          <geometry>
            <sphere>
              <radius>{{ target_radius }}</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>{{ target_color }} 1</ambient>
            <diffuse>{{ target_color }} 1</diffuse>
            <specular>0.6 0.2 0.2 1</specular>
          </material>
          {%- else %}
          <pose>{{ target_visual_pose }}</pose>
          <geometry>
            <mesh>
              <uri>{{ target_mesh_uri }}</uri>
              <scale>{{ target_scale }}</scale>
            </mesh>
          </geometry>
          {%- endif %}
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-12 0 4 0 0.15 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
