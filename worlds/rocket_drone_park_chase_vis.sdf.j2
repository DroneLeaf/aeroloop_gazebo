<?xml version="1.0" ?>
<!--
  Visualization-only world for rocket_drone park chase with Simulink dynamics backend.
  Gazebo renders only — physics engine present for WorldPoseCmd + JointVelocityCmd.
  Drone pose is driven externally via ExternalPosePlugin (UDP 9010).
  Rotor spinning driven by RotorVisualPlugin (UDP 9012).
  Target: orbiting Shahed at altitude 50m, arm radius 30m, orbit speed 0.05 rad/s — patchable via start.py.
-->
<sdf version="1.9">
  <world name="fpv_chase_park">
    <gravity>0 0 0</gravity>
    <physics name="realtime" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <scene>
      {%- if clouds %}
      <sky>
        <time>10</time>
        <clouds>
          <speed>12</speed>
          <direction>1.2</direction>
          <humidity>{{ cloud_density }}</humidity>
          <mean_size>{{ cloud_density }}</mean_size>
        </clouds>
      </sky>
      {%- endif %}
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.85 0.7 1</diffuse>
      <specular>0.3 0.25 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Original baylands terrain (unchanged position) -->
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain</name>
      <pose>-100 150 -0.77 0 0 0</pose>
    </include>
    <!-- 5×5 tiled duplicates (~958m × 628m per tile) centred on original -->
    {%- set tile_cx = -100 %}
    {%- set tile_cy = 150 %}
    {%- set tile_dx = 958 %}
    {%- set tile_dy = 628 %}
    {%- for ix in range(-2, 3) %}
    {%- for iy in range(-2, 3) %}
    {%- if ix != 0 or iy != 0 %}
    <include>
      <uri>model://baylands_terrain</uri>
      <name>baylands_terrain_{{ ix + 2 }}_{{ iy + 2 }}</name>
      <pose>{{ tile_cx + ix * tile_dx }} {{ tile_cy + iy * tile_dy }} -0.77 0 0 0</pose>
    </include>
    {%- endif %}
    {%- endfor %}
    {%- endfor %}

    <model name="desert_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20000 20000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.76 0.60 0.42 1</ambient>
            <diffuse>0.76 0.60 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pedestal — static vis-only cylinder marking the launch stand. Dimensions
         track the Simulink pedestal (pedestal_radius / pedestal_height) so the
         visual base lines up with the on-pedestal attitude physics. -->
    {%- set _ped_r = pedestal_radius | default(0.5) %}
    {%- set _ped_h = pedestal_height | default(0.30) %}
    {%- if _ped_h > 0 %}
    <model name="launch_pedestal">
      <static>true</static>
      <pose>0 0 {{ "%.4g"|format(_ped_h / 2.0) }} 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>true</cast_shadows>
          <geometry>
            <cylinder>
              <radius>{{ "%.4g"|format(_ped_r) }}</radius>
              <length>{{ "%.4g"|format(_ped_h) }}</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.20 0.21 0.24 1</ambient>
            <diffuse>0.33 0.34 0.38 1</diffuse>
            <specular>0.25 0.25 0.28 1</specular>
          </material>
        </visual>
      </link>
    </model>
    {%- endif %}

    <!-- Drone — visualization-only (included from vis model, no physics) -->
    <include>
      <uri>{{ drone_vis_uri }}</uri>
      <name>{{ drone_name }}</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Chase target: pose driven by Python via ExternalPosePlugin (UDP 9016) -->
    <model name="moving_target_drone">
      <static>false</static>
      <pose>{{ "%.4g"|format(orbit_spawn_x) }} {{ "%.4g"|format(orbit_spawn_y) }} {{ "%.4g"|format(target_altitude) }} 0 0 {{ "%.4g"|format(orbit_spawn_yaw) }}</pose>
      <plugin filename="ExternalPosePlugin" name="gz::sim::systems::ExternalPosePlugin">
        <listen_port>9016</listen_port>
      </plugin>
      <link name="geranium_link">
        <visual name="visual">
          <pose>0 0 0 1.57079 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>model://shahed_drone/meshes/shahed.glb</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-35 0 28 0 0.2 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
